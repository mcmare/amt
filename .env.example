# Fill both tokens with separate values from: openssl rand -hex 32
PEER_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
EXIT_TOKEN=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_CHARACTERS
# For a same-host peer + exit Compose deployment use exit:9443.
# For separate VPS use the exit server's reachable hostname:port.
EXIT_ADDRESS=exit:9443
PEER_PORT=443
EXIT_PORT=9443
STREAM_PATH=/_edge/stream
